<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- FIX-CRASH: chạy dạng console để thấy log/exception trực tiếp khi debug. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MyBot.run.dll gốc là module 32-bit, tiến trình phải chạy x86. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Engine OCR + model gốc, copy vào thư mục lib cạnh file exe. -->
    <None Include="..\..\native\lib\**\*.*"
          Link="lib\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyBot.Core\MyBot.Core.csproj" />
    <ProjectReference Include="..\MyBot.Core.FSM\MyBot.Core.FSM.csproj" />
    <ProjectReference Include="..\MyBot.UI\MyBot.UI.csproj" />
    <ProjectReference Include="..\MyBot.UI.Tabs.Log\MyBot.UI.Tabs.Log.csproj" />
    <ProjectReference Include="..\MyBot.Game.CoC\MyBot.Game.CoC.csproj" />
    <ProjectReference Include="..\MyBot.Core.Config\MyBot.Core.Config.csproj" />
    <ProjectReference Include="..\MyBot.Core.Capture\MyBot.Core.Capture.csproj" />
    <ProjectReference Include="..\MyBot.Core.Input\MyBot.Core.Input.csproj" />
    <ProjectReference Include="..\MyBot.Core.CV\MyBot.Core.CV.csproj" />
    <ProjectReference Include="..\MyBot.Core.AntiBan\MyBot.Core.AntiBan.csproj" />
  </ItemGroup>
</Project>
