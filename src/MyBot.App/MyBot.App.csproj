<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- FIX-INT2: Tesseract cần eng.traineddata nằm cạnh file exe ở MỌI cấu hình build. -->
  <ItemGroup>
    <None Update="tessdata\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyBot.Core\MyBot.Core.csproj" />
    <ProjectReference Include="..\MyBot.Core.FSM\MyBot.Core.FSM.csproj" />
    <ProjectReference Include="..\MyBot.UI\MyBot.UI.csproj" />
    <ProjectReference Include="..\MyBot.UI.Tabs.Log\MyBot.UI.Tabs.Log.csproj" />
    <ProjectReference Include="..\MyBot.Game.CoC\MyBot.Game.CoC.csproj" />
    <ProjectReference Include="..\MyBot.Core.Config\MyBot.Core.Config.csproj" />
    <ProjectReference Include="..\MyBot.Core.Capture\MyBot.Core.Capture.csproj" />
    <ProjectReference Include="..\MyBot.Core.Input\MyBot.Core.Input.csproj" />
    <ProjectReference Include="..\MyBot.Core.CV\MyBot.Core.CV.csproj" />
    <ProjectReference Include="..\MyBot.Core.AntiBan\MyBot.Core.AntiBan.csproj" />
  </ItemGroup>
</Project>
