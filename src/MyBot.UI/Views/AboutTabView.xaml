<UserControl x:Class="MyBot.UI.Views.AboutTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="MyBot C# WPF Port"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBlock Text="Version 1.0.0"
                   Foreground="#CCCCCC"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />

        <TextBlock Text="License: GPL-3.0"
                   Foreground="#888888"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <Button Content="Open GitHub Repo"
                Background="#3E3E42"
                Foreground="White"
                BorderBrush="#555555"
                Padding="16,6"
                HorizontalAlignment="Center"
                Click="OpenGitHub_Click" />
    </StackPanel>
</UserControl>
