<UserControl x:Class="MyBot.UI.Views.BottomPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MyBot.UI.Converters"
             mc:Ignorable="d"
             Width="475"
             Height="115"
             Background="{StaticResource BackgroundPanel}">
    <UserControl.Resources>
        <converters:HeroStateToBrushConverter x:Key="HeroStateToBrushConverter" />
        <Style x:Key="HeroBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeroTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: 3 NÚT ĐIỀU KHIỂN -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0">
            <Button Content="START"
                    Command="{Binding StartBotCommand}"
                    Width="70"
                    Height="28"
                    Background="{StaticResource StartButtonColor}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="11"
                    BorderThickness="0"
                    Margin="0,0,0,3" />
            <Button Content="STOP"
                    Command="{Binding StopBotCommand}"
                    Width="70"
                    Height="28"
                    Background="{StaticResource StopButtonColor}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="11"
                    BorderThickness="0"
                    Margin="0,0,0,3" />
            <Button Content="PAUSE"
                    Command="{Binding PauseBotCommand}"
                    Width="70"
                    Height="28"
                    Background="{StaticResource PauseButtonColor}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="11"
                    BorderThickness="0" />
        </StackPanel>

        <!-- PHÂN CÁCH TRÁI-GIỮA -->
        <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1" Fill="{StaticResource BorderControl}" Margin="0,5" />

        <!-- CỘT GIỮA: HERO SHIELDS + TIMERS -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="6,0,6,0">
            <!-- Hàng 1: 6 Hero Shields -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Border Style="{StaticResource HeroBadgeStyle}" Background="{Binding KingState, Converter={StaticResource HeroStateToBrushConverter}}">
                    <TextBlock Text="K" Style="{StaticResource HeroTextStyle}" />
                </Border>
                <Border Style="{StaticResource HeroBadgeStyle}" Background="{Binding QueenState, Converter={StaticResource HeroStateToBrushConverter}}">
                    <TextBlock Text="Q" Style="{StaticResource HeroTextStyle}" />
                </Border>
                <Border Style="{StaticResource HeroBadgeStyle}" Background="{Binding PrinceState, Converter={StaticResource HeroStateToBrushConverter}}">
                    <TextBlock Text="P" Style="{StaticResource HeroTextStyle}" />
                </Border>
                <Border Style="{StaticResource HeroBadgeStyle}" Background="{Binding WardenState, Converter={StaticResource HeroStateToBrushConverter}}">
                    <TextBlock Text="W" Style="{StaticResource HeroTextStyle}" />
                </Border>
                <Border Style="{StaticResource HeroBadgeStyle}" Background="{Binding ChampionState, Converter={StaticResource HeroStateToBrushConverter}}">
                    <TextBlock Text="C" Style="{StaticResource HeroTextStyle}" />
                </Border>
                <Border Style="{StaticResource HeroBadgeStyle}" Background="{Binding DukeState, Converter={StaticResource HeroStateToBrushConverter}}">
                    <TextBlock Text="D" Style="{StaticResource HeroTextStyle}" />
                </Border>
            </StackPanel>

            <!-- Hàng 2: Lab Timer -->
            <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}" Margin="0,0,0,2">
                <Run Text="🔬 Lab: " Foreground="#888888" /><Run Text="{Binding LabTime}" FontWeight="SemiBold" Foreground="{StaticResource ForegroundText}" />
            </TextBlock>

            <!-- Hàng 3: Pet Timer -->
            <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}">
                <Run Text="🐾 Pet: " Foreground="#888888" /><Run Text="{Binding PetTime}" FontWeight="SemiBold" Foreground="{StaticResource ForegroundText}" />
            </TextBlock>
        </StackPanel>

        <!-- PHÂN CÁCH GIỮA-PHẢI -->
        <Rectangle Grid.Column="1" HorizontalAlignment="Right" Width="1" Fill="{StaticResource BorderControl}" Margin="0,5" />

        <!-- CỘT PHẢI: TÀI NGUYÊN & TRẠNG THÁI -->
        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hàng 1: Vàng, Dầu, DE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}" Margin="0,0,0,2">
                    <Run Text="🟡 " FontSize="9" /><Run Text="Gold: " Foreground="{StaticResource GoldText}" /><Run Text="{Binding Gold, StringFormat={}{0:N0}}" Foreground="{StaticResource GoldText}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}" Margin="0,0,0,2">
                    <Run Text="🟣 " FontSize="9" /><Run Text="Elixir: " Foreground="{StaticResource ElixirText}" /><Run Text="{Binding Elixir, StringFormat={}{0:N0}}" Foreground="{StaticResource ElixirText}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}">
                    <Run Text="⚫ " FontSize="9" /><Run Text="DE: " Foreground="{StaticResource DarkElixirText}" /><Run Text="{Binding DarkElixir, StringFormat={}{0:N0}}" Foreground="{StaticResource DarkElixirText}" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>

            <!-- Hàng 2: Cúp, Thợ, Trạng thái -->
            <WrapPanel Grid.Row="1">
                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}" Margin="0,0,8,0">
                    <Run Text="🏆 " FontSize="9" /><Run Text="{Binding Trophies}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}" Margin="0,0,8,0">
                    <Run Text="🔨 " FontSize="9" /><Run Text="{Binding Builders}" FontWeight="SemiBold" /><Run Text="/5" Foreground="#888888" />
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundText}" Margin="0,0,0,0">
                    <Run Text="State: " Foreground="#888888" /><Run Text="{Binding StatusText}" Foreground="{StaticResource ForegroundText}" FontWeight="Bold" />
                </TextBlock>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
