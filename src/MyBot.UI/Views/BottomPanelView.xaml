<UserControl x:Class="MyBot.UI.Views.BottomPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:gui="clr-namespace:MyBot.UI.Gui"
             mc:Ignorable="d"
             d:DesignWidth="472"
             d:DesignHeight="135"
             Width="472"
             Height="135">
    <Grid Width="472" Height="135">
        <!-- Nội dung được dựng trong code-behind từ màn hình "Bottom" của gui-spec.json. -->
        <Canvas x:Name="Host" Width="472" Height="135" />

        <!--
            parity: _GUICtrlStatusBar_Create @ COCBot/MBR GUI Design.au3:304 —
            AutoIt tạo status bar một ô (_GUICtrlStatusBar_SetSimple) trên cửa sổ
            đáy 472x135, dòng chữ "Status : …" do FlushGuiLog cập nhật. Status bar
            của Win32 neo ở đáy và đè lên 23 px cuối, nơi không có control nào
            (control thấp nhất kết thúc ở y=110).
        -->
        <Border x:Name="StatusBar"
                Width="472"
                Height="23"
                VerticalAlignment="Bottom"
                Background="{x:Static gui:GuiPalette.WindowBackground}"
                BorderBrush="{x:Static gui:GuiPalette.Border}"
                BorderThickness="0,1,0,0"
                Panel.ZIndex="1">
            <TextBlock x:Name="StatusBarText"
                       Margin="4,0"
                       VerticalAlignment="Center"
                       Foreground="{x:Static gui:GuiPalette.Text}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusText}" />
        </Border>
    </Grid>
</UserControl>
