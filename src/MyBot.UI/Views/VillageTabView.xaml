<UserControl x:Class="MyBot.UI.Views.VillageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E1E"
             Foreground="White">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <TabControl Background="#1E1E1E" BorderBrush="#333333">
        <!-- 1. Misc -->
        <TabItem Header="Misc" Background="#252526" Foreground="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Village Automation" FontWeight="Bold" FontSize="14" Foreground="#5CAD85" Margin="0,0,0,12" />
                    <CheckBox Content="Collect Resources" IsChecked="{Binding EnableCollector}" />
                    <CheckBox Content="Clear Obstacles" IsChecked="{Binding ClearObstacles}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,10">
                        <TextBlock Text="Keep Builders Free:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Width="60" Text="{Binding KeepBuilders}" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 2. Clan Castle -->
        <TabItem Header="Clan Castle" Background="#252526" Foreground="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Clan Castle Requests" FontWeight="Bold" FontSize="14" Foreground="#5CAD85" Margin="0,0,0,12" />
                    <CheckBox Content="Request CC Troops" IsChecked="{Binding RequestCc}" />

                    <StackPanel Margin="0,4,0,10">
                        <TextBlock Text="Request Message:" Margin="0,0,0,6" />
                        <TextBox Text="{Binding RequestMsg}" Width="250" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 3. Upgrade -->
        <TabItem Header="Upgrade" Background="#252526" Foreground="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Wall &amp; Building Upgrades" FontWeight="Bold" FontSize="14" Foreground="#5CAD85" Margin="0,0,0,12" />
                    <CheckBox Content="Upgrade Walls Automatically" IsChecked="{Binding EnableWallUpgrade}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,10">
                        <TextBlock Text="Use Resource:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding WallResourceOptions}" SelectedItem="{Binding SelectedWallResource}" Width="120" />
                    </StackPanel>

                    <StackPanel Margin="0,4,0,10">
                        <TextBlock Text="Min Gold Reserve:" Margin="0,0,0,6" />
                        <TextBox Text="{Binding MinGoldReserve}" Width="140" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 4. Notify -->
        <TabItem Header="Notify" Background="#252526" Foreground="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Notification Settings" FontWeight="Bold" FontSize="14" Foreground="#5CAD85" Margin="0,0,0,12" />
                    <StackPanel Margin="0,4,0,12">
                        <TextBlock Text="Telegram Bot Token:" Margin="0,0,0,6" />
                        <TextBox Text="{Binding TelegramToken}" Width="300" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Button Content="Test Notify"
                            Command="{Binding TestNotifyCommand}"
                            Width="110"
                            Height="32"
                            Background="#3E3E42"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
