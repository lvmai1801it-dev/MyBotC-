<Window x:Class="MyBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MyBot.UI.Views"
        mc:Ignorable="d"
        Title="MyBot.run v1.0"
        Width="475"
        Height="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="115" />
        </Grid.RowDefinitions>

        <!-- Row 0: Custom Title Bar -->
        <Grid Grid.Row="0"
              Background="{StaticResource BackgroundPanel}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="MyBot.run v1.0"
                       FontSize="12"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Width="45"
                        Height="30"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Content="—"
                        Click="BtnMinimize_Click" />
                <Button Width="45"
                        Height="30"
                        Background="#E81123"
                        Foreground="White"
                        BorderThickness="0"
                        Content="✕"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Content Area (6 Tabs) -->
        <TabControl Grid.Row="1">
            <!-- 1. Log Tab -->
            <TabItem Header="Log">
                <ListBox ItemsSource="{Binding LogMessages}"
                         Background="{StaticResource BackgroundMain}"
                         Foreground="LightGreen"
                         FontFamily="Consolas, Courier New"
                         FontSize="12"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>

            <!-- 2. Village Tab -->
            <TabItem Header="Village">
                <views:VillageTabView />
            </TabItem>

            <!-- 3. Attack Plan Tab -->
            <TabItem Header="Attack Plan">
                <views:AttackTabView />
            </TabItem>

            <!-- 4. Bot Config Tab -->
            <TabItem Header="Bot">
                <views:BotTabView />
            </TabItem>

            <!-- 5. Stats Tab -->
            <TabItem Header="Stats">
                <views:StatsTabView />
            </TabItem>

            <!-- 6. About Tab -->
            <TabItem Header="About">
                <views:AboutTabView />
            </TabItem>
        </TabControl>

        <!-- Row 2: Bottom Panel (UserControl) -->
        <views:BottomPanelView Grid.Row="2" />
    </Grid>
</Window>
