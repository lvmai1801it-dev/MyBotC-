<Window x:Class="MyBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MyBot.UI.ViewModels"
        xmlns:views="clr-namespace:MyBot.UI.Views"
        mc:Ignorable="d"
        Title="MyBot.run v1.0"
        Width="475"
        Height="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="115" />
        </Grid.RowDefinitions>

        <!-- Row 0: Custom Title Bar -->
        <Grid Grid.Row="0"
              Background="#2D2D30"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="MyBot.run v1.0"
                       FontSize="12"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Width="45"
                        Height="30"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Content="—"
                        Click="BtnMinimize_Click" />
                <Button Width="45"
                        Height="30"
                        Background="#E81123"
                        Foreground="White"
                        BorderThickness="0"
                        Content="✕"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Content Area (Log Tab) -->
        <TabControl Grid.Row="1"
                    Background="#1E1E1E"
                    BorderBrush="#2D2D30"
                    BorderThickness="0,1,0,0">
            <TabItem Header="Log"
                     Background="#252526"
                     Foreground="White">
                <ListBox ItemsSource="{Binding LogMessages}"
                         Background="#1E1E1E"
                         Foreground="LightGreen"
                         FontFamily="Consolas, Courier New"
                         FontSize="12"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>

        <!-- Row 2: Bottom Panel (UserControl) -->
        <views:BottomPanelView Grid.Row="2" />
    </Grid>
</Window>
