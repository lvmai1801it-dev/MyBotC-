<Window x:Class="MyBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MyBot.run"
        Width="472"
        Height="715"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!--
        Cửa sổ chính dựng lại đúng bố cục AutoIt (MBR GUI Design.au3:196-355).
        Toàn bộ toạ độ là pixel tuyệt đối trên một Canvas 472x715:

          0    .. 23   thanh tiêu đề tự vẽ (nhãn trắng + 4 nút caption)
          23   .. 90   ảnh logo   (images/Logo.png, 472x67)
          90   .. 103  ảnh URL    (images/LogoURL.png, 472x13)
          108  .. 575  tab control chính 463x467 — dựng bởi MainGuiBuilder
          580  .. 715  panel đáy 472x135  — dựng từ màn hình "Bottom"
    -->
    <Canvas x:Name="RootCanvas" Width="472" Height="715" Background="#F0F0F0">

        <!--
            Thanh tiêu đề tự vẽ — chỉ dùng khi botDesignFlags bit 0 = 1.
            parity: CreateMainGUI @ COCBot/MBR GUI Design Mini.au3:126.
        -->
        <Canvas x:Name="TitleBarHost" Canvas.Left="0" Canvas.Top="0" Width="472" Height="23">

            <!-- Vùng kéo cửa sổ bên trái thanh tiêu đề (25px, trước tiêu đề). -->
            <Border Canvas.Left="0" Canvas.Top="0"
                    Width="25" Height="23"
                    Background="White"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

            <!-- Tiêu đề: rộng = 472 - 4*25 - 25 = 347, chữ Segoe UI 11pt màu #171717. -->
            <Border Canvas.Left="25" Canvas.Top="0"
                    Width="347" Height="23"
                    Background="White"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                           FontFamily="Segoe UI"
                           FontSize="14.667"
                           Foreground="#171717"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Nút thu nhỏ / mini / đóng (25x17 mỗi nút, đặt tại x = 372, 397, 422, 447). -->
            <Border Canvas.Left="372" Canvas.Top="0" Width="25" Height="17" Background="#F0F0F0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="&#x25C4;" FontFamily="Segoe UI" FontSize="13.333"
                           Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Canvas.Left="397" Canvas.Top="0" Width="25" Height="17" Background="#F0F0F0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="&#x2584;" FontFamily="Segoe UI" FontSize="13.333"
                           Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="MinimizeButton" Canvas.Left="422" Canvas.Top="0" Width="25" Height="17"
                    Background="#F0F0F0" Cursor="Hand"
                    MouseLeftButtonDown="BtnMinimize_Click">
                <TextBlock Text="&#x0336;" FontFamily="Segoe UI" FontSize="13.333"
                           Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="CloseButton" Canvas.Left="447" Canvas.Top="0" Width="25" Height="17"
                    Background="#FF4040" Cursor="Hand"
                    MouseLeftButtonDown="BtnClose_Click">
                <TextBlock Text="&#x00D7;" FontFamily="Segoe UI" FontSize="13.333"
                           Foreground="#F8F8F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Dải trắng lấp khoảng trống dưới hàng nút caption (6px). -->
            <Border Canvas.Left="372" Canvas.Top="17" Width="100" Height="6" Background="White"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
        </Canvas>

        <!-- Ảnh logo và dải URL (nạp từ images/ cạnh file thực thi). -->
        <Image x:Name="LogoImage" Canvas.Left="0" Canvas.Top="23"
               Width="472" Height="67" Stretch="Fill"
               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
        <Image x:Name="LogoUrlImage" Canvas.Left="0" Canvas.Top="90"
               Width="472" Height="13" Stretch="Fill"
               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

        <!-- Tab control chính, được đổ nội dung trong MainWindow.xaml.cs. -->
        <Canvas x:Name="TabsHost" Canvas.Left="5" Canvas.Top="108" Width="463" Height="467" />

        <!-- Panel đáy 472x135. -->
        <ContentControl x:Name="BottomHost" Canvas.Left="0" Canvas.Top="580" Width="472" Height="135" />
    </Canvas>
</Window>
